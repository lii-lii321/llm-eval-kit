# OpenAI 兼容接口配置（LLM-as-judge 可选）
# 复制为 .env 或直接设置环境变量。以下全部是占位符，不是真实密钥。
# 未设置 EVAL_LLM_API_KEY 时，LLM 评分会优雅跳过，检索评测与报告不受影响。

# API key（必填才会启用 LLM 评分；示例为占位符）
EVAL_LLM_API_KEY=sk-your-api-key-here

# OpenAI 兼容服务地址（默认 https://api.openai.com/v1）
EVAL_LLM_BASE_URL=https://api.openai.com/v1

# 模型名（默认 gpt-4o-mini）
EVAL_LLM_MODEL=gpt-4o-mini

# 请求超时秒数（默认 30）
EVAL_LLM_TIMEOUT=30

# 置 1 放行 localhost/内网地址（自建模型服务如 Ollama 需要开启）
EVAL_LLM_ALLOW_LOCAL=0
